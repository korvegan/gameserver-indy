{
  "name": "korvegan/gameserver-indy",
  "description": "Isolated Symfony migration slice for GameServer Indy",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-pdo_sqlite": "*",
    "ext-sqlite3": "*",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.0",
    "symfony/cache": "7.4.*",
    "symfony/clock": "7.4.*",
    "symfony/config": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/doctrine-bridge": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/finder": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/password-hasher": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/security-http": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/twig-bridge": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/type-info": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/var-exporter": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/dom-crawler": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"sort-packages": true, "allow-plugins": false},
  "scripts": {"test": "phpunit", "lint": "php bin/console lint:container"}
}
