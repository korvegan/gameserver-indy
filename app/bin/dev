<?php
declare(strict_types=1);

require dirname(__DIR__).'/src/Foundation.php';
require dirname(__DIR__).'/src/Access.php';

$port = $argv[1] ?? '18765';
$engine = getenv('SLICE_FRANKENPHP');
$familyPort = $argv[2] ?? null;
$familyHost = $argv[3] ?? null;
if (!in_array($argc, [1,2,4], true) || !ctype_digit($port) || (int) $port < 1024 || (int) $port > 65535
    || ($familyPort !== null && (!ctype_digit($familyPort) || (int) $familyPort < 1024
        || (int) $familyPort > 65535 || (int) $familyPort === (int) $port
        || !preg_match('/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.ts\.net$/D', $familyHost ?? '')))) {
    fwrite(STDERR, "Aufruf: php app/bin/dev [Port [Familien-Testport Tailscale-Hostname]]\n");
    exit(2);
}
if (!$engine || !is_file($engine) || !is_executable($engine) || !function_exists('pcntl_exec')) {
    fwrite(STDERR, "SLICE_FRANKENPHP auf die vorhandene ausführbare FrankenPHP-Datei setzen; PHP-CLI benötigt pcntl.\n");
    exit(2);
}
$fixture = \IndyNext\FixtureStore::create();
\IndyNext\AccessStore::create($fixture);
echo 'Fixture: '.$fixture."\n";
echo 'URL: http://127.0.0.1:'.(int) $port."\n";
flush();
$environment = array_intersect_key(getenv(), array_flip(['PATH', 'HOME', 'LANG', 'LC_ALL', 'TMPDIR']));
$environment['INDY_NEXT_PORT'] = (string) (int) $port;
$environment['INDY_NEXT_FIXTURE'] = $fixture;
$environment['INDY_FAMILY_CONFIG'] = $familyPort === null ? 'family-disabled.caddy' : 'family.caddy';
if ($familyPort !== null) {
    $environment['INDY_FAMILY_PORT'] = (string) (int) $familyPort;
    $environment['INDY_FAMILY_HOST'] = $familyHost;
}
$revisionFile = dirname(__DIR__, 2).'/REVISION';
$revision = is_file($revisionFile) ? trim(file_get_contents($revisionFile)) : 'development';
if (!preg_match('/^(development|[a-f0-9]{40})$/D', $revision)) {
    throw new RuntimeException('invalid_release_revision');
}
$environment['INDY_APP_BUILD'] = $revision;
$environment['XDG_CONFIG_HOME'] = $fixture.'/config';
$environment['XDG_DATA_HOME'] = $fixture.'/data';
chdir(dirname(__DIR__));
pcntl_exec($engine, ['run', '--config', __DIR__.'/../Caddyfile', '--adapter', 'caddyfile'], $environment);
fwrite(STDERR, "FrankenPHP konnte nicht gestartet werden.\n");
exit(1);
