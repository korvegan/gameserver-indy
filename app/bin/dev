<?php
declare(strict_types=1);

require dirname(__DIR__).'/src/Foundation.php';
require dirname(__DIR__).'/src/Access.php';
require dirname(__DIR__).'/src/WindowsBridge.php';
require dirname(__DIR__).'/src/ServerRuntime.php';
require dirname(__DIR__).'/src/HttpServer.php';

$port = $argv[1] ?? '18765';
$engine = getenv('SLICE_FRANKENPHP');
$familyPort = $argv[2] ?? null;
$familyHost = $argv[3] ?? null;
if (!in_array($argc, [1,2,4], true) || !ctype_digit($port) || (int) $port < 1024 || (int) $port > 65535
    || ($familyPort !== null && (!ctype_digit($familyPort) || (int) $familyPort < 1024
        || (int) $familyPort > 65535 || (int) $familyPort === (int) $port
        || !preg_match('/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.ts\.net$/D', $familyHost ?? '')))) {
    fwrite(STDERR, "Aufruf: php app/bin/dev [Port [Familien-Testport Tailscale-Hostname]]\n");
    exit(2);
}
if (!$engine || !is_file($engine) || !is_executable($engine) || !function_exists('pcntl_exec')) {
    fwrite(STDERR, "SLICE_FRANKENPHP auf die vorhandene ausführbare FrankenPHP-Datei setzen; PHP-CLI benötigt pcntl.\n");
    exit(2);
}
$php = getenv('SLICE_PHP') ?: PHP_BINARY;
if (!is_executable($php) || !is_executable('/usr/bin/setsid')) {
    fwrite(STDERR, "Vorhandenen PHP-CLI-Startweg und setsid aus util-linux prüfen.\n");
    exit(2);
}
$fixture = \IndyNext\FixtureStore::create();
\IndyNext\AccessStore::create($fixture);
\IndyNext\ServerRuntime::createFixture($fixture, $php);
echo 'Fixture: '.$fixture."\n";
echo 'URL: http://127.0.0.1:'.(int) $port."\n";
flush();
\IndyNext\HttpServer::run($fixture, ['port'=>(int) $port, 'family_port'=>$familyPort === null ? null : (int) $familyPort,
    'family_host'=>$familyHost, 'engine'=>$engine, 'php'=>$php]);
