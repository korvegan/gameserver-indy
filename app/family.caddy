http://:{$INDY_FAMILY_PORT} {
	bind 127.0.0.1
	root * public
	request_body {
		max_size 4KB
	}
	php_server {
		env INDY_LISTENER family
		env INDY_FAMILY_HOST {$INDY_FAMILY_HOST}
		env INDY_NEXT_PORT {$INDY_NEXT_PORT}
		env INDY_NEXT_FIXTURE {$INDY_NEXT_FIXTURE}
		env INDY_APP_BUILD {$INDY_APP_BUILD}
	}
}
